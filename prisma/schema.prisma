generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  entityType     String   @default("mairie")
  description    String?
  address        String?
  postCode       String
  cityName       String
  department     String?
  region         String?
  country        String   @default("FR")
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  logoUrl        String?
  website        String?
  source         String   @default("manual")
  sourceId       String?
  importedAt     DateTime?
  lastSyncAt     DateTime?
  subscriptionTier String @default("free")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notices        OfficialNotice[]
  users          User[]

  @@map("tenants")
}

model OfficialNotice {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  content        String
  contentText    String?
  summary        String?
  category       String?
  signType       String?
  isLegal        Boolean  @default(false)
  publishedAt    DateTime?
  modifiedAt     DateTime?
  expiresAt      DateTime?
  source         String   @default("panneaupocket_import")
  sourceId       String?
  sourceUrl      String?
  contentHash    String?
  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  medias         Media[]

  @@unique([tenantId, sourceId])
  @@index([tenantId, isPublished])
  @@index([tenantId, category])
  @@index([contentHash])
  @@map("official_notices")
}

model Media {
  id             String   @id @default(cuid())
  noticeId       String
  notice         OfficialNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  type           String   @default("image")
  url            String
  thumbnailUrl   String?
  altText        String?
  width          Int?
  height         Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([noticeId])
  @@map("media")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  image          String?
  role           String   @default("citizen")
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]

  @@index([tenantId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}